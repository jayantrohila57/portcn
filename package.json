{
  "name": "portcn",
  "version": "0.0.1",
  "private": true,
  "description": "An open-source, developer-first CLI for discovering, inspecting, monitoring, and managing application ports and local services.",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "turbo run check-types",
    "test": "pnpm -r --if-present run test",
    "release:check": "node scripts/check-package-versions.mjs",
    "package:check": "node scripts/check-cli-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "turbo": "^2.11.13"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  }
}
