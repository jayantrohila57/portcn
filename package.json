{
  "name": "@portcn/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "The portcn CLI monorepo workspace.",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check package.json pnpm-workspace.yaml turbo.json biome.json commitlint.config.mjs .release-please-manifest.json release-please-config.json scripts .github && turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "turbo run check-types",
    "test": "pnpm -r --if-present run test",
    "branch-policy:check": "node scripts/check-branch-policy.mjs",
    "boundaries:check": "node scripts/check-workspace-boundaries.mjs",
    "release:check": "node scripts/check-package-versions.mjs",
    "package:check": "node scripts/check-cli-package.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,jsonc,css,md,mdx,graphql}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "turbo": "^2.11.13"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  }
}
